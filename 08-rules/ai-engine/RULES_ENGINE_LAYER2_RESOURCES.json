  "description": "AI Rules Engine - Layer 2 (Resource Rules) - Ultra-detailed validation system for resource economy",
  
  "LAYER_2_RESOURCE_RULES": {
    
    "2.1_KUNDALINI_POWER_KP": {
      "description": "Universal resource required for all glyph activations",
      
      "2.1.1_KP_generation": {
        "rule_id": "R-2.1.1",
        "description": "How KP is generated each turn",
        "base_generation": {
          "amount": 1,
          "timing": "START_OF_TURN phase",
          "guaranteed": true,
          "description": "Every player gains +1 KP automatically at turn start"
        },
        "maximum_KP": {
          "base_cap": 10,
          "description": "Maximum KP that can be stored",
          "overflow_behavior": "Excess KP generation is wasted (does not carry over)",
          "validation": "player.KP <= 10 (unless modified by effects)"
        },
        "bonus_generation": [
          {
            "source": "Sun planetary influence",
            "condition": "Sun Tier 2+",
            "bonus": "+1 KP per turn (total +2)",
            "note": "Doubles base KP generation"
          },
          {
            "source": "Certain Foundational glyphs",
            "examples": ["Structure (Skill 5): +1 KP if no damage taken last turn"],
            "conditional": true
          },
          {
            "source": "Singularity Coherence Engine",
            "condition": "Pattern Recognition tier bonuses",
            "bonus": "Variable (+1 to +2 KP depending on patterns)"
          }
        ],
        "sub_rules": {
          "2.1.1.1_first_turn_KP": {
            "rule_id": "R-2.1.1.1",
            "description": "Both players start with 3 KP at round start",
            "reason": "Prevents slow early game, allows immediate glyph usage",
            "validation": "at_round_start: player.KP = 3"
          },
          "2.1.1.2_KP_cap_increases": {
            "rule_id": "R-2.1.1.2",
            "description": "Maximum KP can be increased by effects",
            "examples": [
              "Jupiter Tier 3+: +2 max KP (cap becomes 12)",
              "Certain Foundational glyphs: +1 to +3 max KP",
              "Singularity Infinite Capacity: Removes KP cap entirely (rare)"
            ],
            "validation": "player.max_KP = base_cap + modifiers"
          }
        }
      },
      
      "2.1.2_KP_spending": {
        "rule_id": "R-2.1.2",
        "description": "How KP is consumed when activating glyphs",
        "cost_structure": {
          "base_cost": "All glyphs cost 1-3 KP + engine resource",
          "tier_scaling": [
            "Tier 1 glyphs: 1 KP",
            "Tier 2 glyphs: 2 KP",
            "Tier 3 glyphs: 3 KP",
            "Ultimate glyphs: 3-4 KP"
          ],
          "validation": "player.KP >= glyph.KP_cost"
        },
        "cost_reduction": [
          {
            "source": "Mercury planetary influence",
            "condition": "Mercury Tier 2+",
            "effect": "-1 KP cost to all glyphs (minimum 0)",
            "example": "Tier 2 glyph costs 2 KP → Reduced to 1 KP"
          },
          {
            "source": "Consciousness Engine efficiency",
            "condition": "Alpha/Beta/Gamma State active",
            "effect": "Specific glyphs cost -1 KP while in state",
            "state_dependent": true
          },
          {
            "source": "Character Analysis prediction bonuses",
            "condition": "Correct prediction made",
            "effect": "Next glyph costs -1 KP",
            "duration": "1 turn after prediction"
          }
        ],
        "insufficient_KP_behavior": {
          "validation": "if (player.KP < glyph.KP_cost) { block_activation() }",
          "UI_indication": "Glyph grayed out, shows KP deficit",
          "error_message": "Not enough KP! Need X, have Y"
        },
        "sub_rules": {
          "2.1.2.1_free_activation": {
            "rule_id": "R-2.1.2.1",
            "description": "Certain effects allow free glyph activation (0 KP cost)",
            "examples": [
              "Invocation: Grace overflow (50+ Grace) → Next glyph free",
              "Character Analysis: Perfect Prediction → Next glyph free",
              "Foundational: Grounding (Skill 25) → Next defensive glyph free"
            ],
            "limitation": "Usually limited to 1 free activation per trigger"
          },
          "2.1.2.2_KP_refund": {
            "rule_id": "R-2.1.2.2",
            "description": "Some glyphs refund KP under conditions",
            "examples": [
              "Character Analysis: If prediction correct → Refund 1 KP",
              "Singularity: If pattern detected → Refund 2 KP",
              "Invocation: Divine Surge → Refund KP if overkill"
            ],
            "timing": "Refund occurs immediately after glyph resolves",
            "validation": "player.KP = min(player.KP + refund_amount, max_KP)"
          }
        }
      },
      
      "2.1.3_KP_manipulation": {
        "rule_id": "R-2.1.3",
        "description": "Effects that steal, deny, or manipulate opponent KP",
        "KP_denial": [
          {
            "glyph": "Tantra: Energy Drain",
            "effect": "Opponent gains 0 KP next turn",
            "duration": "1 turn",
            "stacks": "No (multiple applications extend duration)"
          },
          {
            "glyph": "Singularity: Void Lock",
            "effect": "Both players gain 0 KP for 2 turns",
            "symmetrical": true,
            "strategic": "Use when ahead in KP to lock advantage"
          }
        ],
        "KP_stealing": [
          {
            "glyph": "Tantra: Siphon",
            "effect": "Steal 1-2 KP from opponent",
            "validation": "opponent.KP = max(0, opponent.KP - steal_amount); player.KP = min(player.KP + steal_amount, max_KP)"
          },
          {
            "glyph": "Character Analysis: Resource Prediction",
            "effect": "If prediction correct → Steal 2 KP",
            "conditional": true
          }
        ],
        "KP_burning": [
          {
            "description": "Force opponent to waste KP",
            "glyph": "Foundational: Disruption",
            "effect": "Opponent loses 2 KP (not transferred, just lost)",
            "validation": "opponent.KP = max(0, opponent.KP - 2)"
          }
        ],
        "sub_rules": {
          "2.1.3.1_cannot_steal_below_zero": {
            "rule_id": "R-2.1.3.1",
            "description": "KP cannot go negative",
            "validation": "player.KP = max(0, calculated_KP)",
            "example": "Opponent has 1 KP, you try to steal 2 → You only steal 1, opponent has 0"
          }
        }
      }
    },
    
    "2.2_ENGINE_SPECIFIC_RESOURCES": {
