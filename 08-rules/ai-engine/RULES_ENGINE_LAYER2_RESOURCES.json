        "sub_rules": {
          "2.3.1.1_conversion_efficiency": {
            "rule_id": "R-2.3.1.1",
            "description": "Jyotish chart affects conversion rates",
            "modifiers": [
              "Venus Tier 2+: All conversions +10% efficiency",
              "2nd House (Resources): +15% conversion rates",
              "Specific glyph upgrades: +20% to +50% efficiency"
