        "automatic_conversions": [
          {
            "trigger": "Sanctity overflow",
            "conversion": "2 Sanctity → 1 Grace",
            "condition": "Sanctity reaches cap",
            "automatic": true
          },
          {
            "trigger": "Bandwidth overflow",
