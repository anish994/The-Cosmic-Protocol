  "VALIDATION_FRAMEWORK": {
    "description": "How AI validates resource actions",
    "validation_process": [
      {
        "step": 1,
        "action": "Player attempts glyph activation",
        "validation": "Check if player has required KP + engine resource"
      },
      {
        "step": 2,
        "action": "Deduct resource costs",
        "validation": "player.KP -= glyph.KP_cost; player.engine_resource -= glyph.engine_cost"
      },
      {
        "step": 3,
        "action": "Check resource caps",
        "validation": "Ensure no resource exceeds max cap (accounting for Jyotish modifiers)"
      },
      {
        "step": 4,
        "action": "Apply overflow conversions",
        "validation": "Auto-convert excess resources per rules (Sanctity→Grace, Bandwidth→Coherence, etc.)"
      },
      {
        "step": 5,
        "action": "Trigger resource-based effects",
        "validation": "Check threshold bonuses (Grace 20+, Prana Overload, etc.)"
      }
    ],
