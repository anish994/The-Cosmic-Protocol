{
  "_schema_version": "4.0",
  "_description": "Canonical keyword lexicon from Global Balance Schema v4.0 - all keywords standardized",
  
  "status_effects": {
    "[Burn]": {
      "category": "DoT",
      "definition": "Deals X damage/turn for Y turns; stacks increase damage",
      "stack_cap": 10,
      "mars_modifier": "+30% damage",
      "detonation_fuel": true
    },
    "[Decay]": {
      "category": "Entropy",
      "definition": "Entropy marker; +10% detonation damage per stack; no cap",
      "consumed_by": "[Detonate]",
      "jupiter_effect": "Makes detonation AoE"
    },
    "[Silence]": {
      "category": "Control",
      "definition": "Prevents casting abilities",
      "max_duration": "2 turns total in any 4-turn window",
      "counterplay": "[Cleanse] removes"
    },
    "[Stasis]": {
      "category": "Control",
      "definition": "Disables actions/increases cooldown",
      "stack_cap": "2-5 (engine-specific)",
      "saturn_effect": "+duration",
      "counterplay": "[Cleanse] removes 1 stack"
    },
    "[Banish]": {
      "category": "Removal",
      "definition": "Temporarily removes entity/glyph for 1-3 turns",
      "return_effect": "Summoning sickness (can't act 1 turn)",
      "ketu_effect": "+effectiveness"
    },
    "[Transcendent]": {
      "category": "Buff",
      "definition": "Immune to negative effects; +50% positive effects",
      "duration": "2-5 turns",
      "stacks": "Yes (+25% per stack)",
      "jupiter_effect": "Extends duration"
    },
    "[Seal]": {
      "category": "Protection",
      "definition": "Protects next effect from counter/cancel",
      "single_use": true,
      "stackable": true,
      "engine": "Divination core mechanic"
    },
    "[Omen]": {
      "category": "Tagged Draw",
      "definition": "Tagged draw with conditional bonus; +30% if condition met",
      "engine": "Divination core"
    },
    "[Mark]": {
      "category": "Debuff",
      "definition": "Debuff stack on enemy; +20-100% damage per mark",
      "stack_cap": 10,
      "mercury_effect": "-cooldown",
      "engine": "Character Analysis core"
    },
    "[Shield]": {
      "category": "Defense",
      "definition": "Absorbs damage until depleted or duration ends",
      "overflow": "Converts to Insight",
      "venus_effect": "+30%",
      "pushya_effect": "Regenerates shield per turn"
    }
  },
  
  "action_keywords": {
