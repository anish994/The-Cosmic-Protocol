  "grammar_operators": {
    "Apply": "Add status effect with stacks/duration",
    "Consume": "Remove stacks for benefit",
    "Detonate": "Calculate potency from consumed stacks",
    "Bind": "Attach planetary effect to engine",
    "Transit": "Trigger periodic effect",
    "Seal": "Grant protection to next eligible effect",
    "Chant": "Increment ritual counter with breakpoints",
    "Charge": "Increase threshold counters toward collapse"
  }
