  "DETECTION_ALGORITHM_PSEUDOCODE": {
    "description": "How The Crucible detects chains in real-time",
    "code": `
      function detectChains(skillsInGrid) {
        const chains = [];
        
        // Check all skill triplets (A, B, C)
        for (let i = 0; i < skillsInGrid.length - 2; i++) {
          const skillA = skillsInGrid[i];
          const skillB = skillsInGrid[i + 1];
          const skillC = skillsInGrid[i + 2];
          
          // Check if A creates condition B exploits
          if (skillA.creates_condition) {
            if (skillB.exploits_condition === skillA.creates_condition) {
              // Chain detected! Check if C extends it
              if (skillC.exploits_condition === skillB.creates_condition) {
                chains.push({
                  type: "3-skill chain",
                  skills: [skillA, skillB, skillC],
                  power_multiplier: 1.5,
                  visualization: "A→B→C"
                });
              } else {
                chains.push({
                  type: "2-skill chain",
                  skills: [skillA, skillB],
                  power_multiplier: 1.3,
                  visualization: "A→B"
                });
              }
            }
          }
        }
        
        // Check for loop formations
        for (const chain of chains) {
          if (chain.skills[chain.skills.length - 1].creates_condition ===
              chain.skills[0].exploits_condition) {
            chain.type = "INFINITE LOOP";
            chain.power_rating = 10;
            chain.warning = "Self-sustaining combo detected!";
          }
        }
        
        return chains;
      }
    `
  },

